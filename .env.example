# SkinSense Environment Variables

# App
APP_NAME=SkinSense
VERSION=0.1.0

# Database (SQLite)
DATABASE_URL=sqlite:///./skinsense.db

# Auth
AUTH_SECRET=generate-a-secure-random-32-char-string-here

# AI (Open-weight models - local via Ollama/LM Studio)
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:8b
MODEL_ENDPOINT=http://localhost:11434/v1

# Voice (ElevenLabs - optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ENABLE_VOICE=false

# Environment
ENVIRONMENT=development

# OCR
TESSERACT_PATH=
